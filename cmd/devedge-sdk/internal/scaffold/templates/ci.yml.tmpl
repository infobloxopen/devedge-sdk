name: CI

# Build, generate, and test {{.Service}} on every push/PR. The implementation in
# gen/ is git-ignored, so CI MUST generate before it builds. `de` is the hermetic
# build authority (WS-023): `de generate` installs the PINNED buf CLI + codegen
# plugins — the devedge-sdk plugins pinned to the devedge-sdk version in go.mod
# (the single source of truth) — and regenerates the consumer-local code; `de
# test` then builds + runs the tests. No `@latest` tool installs, no separate buf
# step: the tool versions live in the pinned `de`.

on:
  push:
    branches: ["main"]
  pull_request:

permissions:
  contents: read

jobs:
  build-test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Set up Go
        uses: actions/setup-go@v5
        with:
          go-version-file: go.mod
          cache: true

      - name: Install de (the devedge build authority)
        run: go install github.com/infobloxopen/devedge/cmd/de@{{.DeVersion}}

      - name: Generate consumer-local code
        run: de generate

      - name: Build & test
        run: de test
