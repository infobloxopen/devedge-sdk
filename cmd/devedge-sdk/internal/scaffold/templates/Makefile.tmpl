# {{.Service}} — top-level Makefile (hand-owned).
#
# `de` (the devedge build authority) owns codegen, build, test, lint, and the
# container image — hermetically, with the buf CLI + codegen plugins PINNED by
# the `de` binary and the devedge-sdk plugins pinned to the SDK version in this
# project's go.mod. There are no unpinned tool installs here anymore: that logic
# lives in `de`. This Makefile just reads the managed shim `de sync` writes and
# adds the project-specific targets below.
#
# Requires `de` on PATH. Install the latest release binary from
#     https://github.com/infobloxopen/devedge/releases
# (the de module uses a replace directive, so go install does not work).
#
# Then, on a fresh clone (gen/ is git-ignored — see the README), generate first:
#     de generate    # buf generate -> gen/ (+ OpenAPI v3{{- if eq (printf "%s" .Backend) "ent" }}, then the entc client{{- end }}), then go mod tidy
#     de build       # go build ./...
#     de test        # go test ./...
#
# The managed shim provides generate/build/test/lint/image/migrate-lint, each
# delegating to `de`. Regenerate it with `de sync` (it is idempotent). If it is
# ever missing (a checkout before `de sync` ran), run `de sync` to (re)write it.
-include .devedge/make/devedge.mk

.PHONY: run api-lint api-breaking api-release slo sync-migrations

# Full-text search migrations (WS-041). An INDEXED searchable resource makes
# `de generate` emit a persisted `search_vector` generated column + a GIN index as
# SQL migrations. buf writes them under gen/migrations/ — which is GIT-IGNORED and is
# NOT the dir this module embeds/applies (module/migrations/, committed). So before we
# build, test, or run, sync those generated files into the committed, embedded
# migrations dir so `//go:embed migrations` picks them up and the host migrator applies
# them (otherwise an INDEXED resource hits `column "search_vector" does not exist` at
# runtime). These are prerequisite-only lines (no recipe): they MERGE the dependency
# into the .devedge/make/devedge.mk build/test recipes without overriding them.
build test: sync-migrations

# sync-migrations copies the generator-emitted FTS migrations from the git-ignored
# gen/migrations/ into the committed, embedded module migrations dir. Generated files
# use the reserved 9001+ version band — far above your hand-authored 0002+ migrations —
# so this only ever refreshes the generated files; it never clobbers a migration you
# wrote and never deletes anything. Idempotent (content-compared) and a no-op when there
# is nothing to sync, so it is safe to run on every build. If you invoke `de generate`
# directly (not via `make`), run `make sync-migrations` afterward.
sync-migrations:
	@if [ -d gen/migrations ]; then \
		mkdir -p module/migrations; \
		for f in gen/migrations/*.sql; do \
			[ -e "$$f" ] || continue; \
			dst="module/migrations/$$(basename "$$f")"; \
			cmp -s "$$f" "$$dst" 2>/dev/null || { cp "$$f" "$$dst"; echo "sync-migrations: $$dst"; }; \
		done; \
	fi

# slo regenerates slo.yaml (the service's reliability targets, WS-025) from the
# enriched OpenAPI, picking up any custom methods beyond the standard CRUD. The
# scaffold already ships a GOOD default slo.yaml (derived from the resource's AIP
# methods: good/valid availability + latency, a mandatory error-budget policy, a
# 28d window, all marked un-calibrated), so this is only needed after you add
# custom methods. `de` pins the generator to this project's SDK version (hermetic).
# Then lint it (the classifier rejects a signal-declared-as-an-SLI) and, to deploy
# the burn-rate rules, render + set monitoring.enabled in your values overlay:
#     de slo lint slo.yaml
#     de slo render --target prometheus --in slo.yaml --out deploy/prometheus
slo:
	de slo generate

# Run the service locally. Observability is on by default behind the OTel seam:
# export the standard OTEL_* env to ship traces + RED metrics to a collector (no
# code change), e.g. `OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317 make run`.
# With no endpoint set the exporter no-ops, so this runs with zero overhead.
# gen/ is git-ignored — run `de generate` first on a fresh clone.
run: sync-migrations
	go run ./cmd/{{.BinName}}

# apx governs the PUBLIC proto surface. Run these locally BEFORE pushing — CI runs
# the same gates (see .github/workflows/apx-release.yml).
#
#   api-lint     STANDARD lint of the public proto.
#   api-breaking compatibility check vs the last committed proto (HEAD): catches an
#                accidental breaking change before it lands. Requires an initialized
#                git repo with at least one commit; run `git init && git add . &&
#                git commit -m "initial"` first if this is a fresh scaffold. After
#                that, with no prior API tag, it passes. Once released, compare
#                against the released tag instead.
#   api-release  prepare a versioned release of the public API. NOTE: this emits a
#                NON-FATAL go_package mismatch warning ("got .../gen/{{.GoPkg}},
#                expected .../proto/{{.ProtoPathSuffix}}"). It is EXPECTED and
#                HARMLESS: the scaffold's generated Go must be a single directory
#                segment under gen/ so the sibling ent/ package compiles, which is
#                not the <module>/<api-id> layout apx derives by default. The
#                command exits 0. Do NOT add --strict, which would turn it fatal.
api-lint:
	@command -v spectral >/dev/null 2>&1 || echo "note: 'apx lint' lints the OpenAPI surface with spectral — install it with 'npm install -g @stoplight/spectral-cli'."
	apx lint

# NOTE: when there ARE violations, apx itself prints the buf violation list twice
# (once raw, once in its summary). That double-print is apx's own output, not this
# single invocation — nothing to fix here.
api-breaking:
	@if ! git rev-parse --git-dir > /dev/null 2>&1 || ! git rev-parse HEAD > /dev/null 2>&1; then \
		echo "api-breaking requires a git repo with at least one commit."; \
		echo "Run: git init && git add . && git commit -m \"initial\""; \
		exit 1; \
	fi
	apx breaking --against HEAD

# The api-id is the proto's path under the module root (module_roots: [proto]).
api-release:
	apx release prepare proto/{{.ProtoPathSuffix}} --version v1.0.0-alpha.1 --lifecycle experimental
