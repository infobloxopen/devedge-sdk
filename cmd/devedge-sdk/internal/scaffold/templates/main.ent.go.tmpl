// Command {{.BinName}} runs the {{.ServiceType}} (ent backend).
//
// The server is wired by construction:
//   - server.New configures the gRPC + HTTP-gateway stack and the authz interceptor;
//   - {{.GoPkg}}.Register{{.ServiceType}}WithRepository wires the GENERATED default CRUD
//     handler over the GENERATED ent repository adapter ({{.GoPkg}}.New{{.Resource}}EntRepository
//     — produced by protoc-gen-ent, F027: no hand-written ent wiring, no hand-written
//     handler) and contributes the service's authz rules to the server;
//   - server.Serve asserts at boot that every registered RPC has an authz rule
//     (fail-closed) and refuses to start otherwise.
//
// This file is hand-owned (NOT generated). It owns the environment wiring (open
// the ent client, migrate, choose the authorizer/principal); the handler + rule
// wiring are generated. To add custom (non-CRUD) logic, embed
// {{.GoPkg}}.{{.ServiceType}}CRUDHandler, override the methods you change, and
// register it with {{.GoPkg}}.Register{{.ServiceType}}(s, h).
{{- if .Aggregate}}
//
// {{.Resource}} is a DDD aggregate ROOT (it owns {{.Member}} members). This file
// additionally wires the aggregate + transactional-outbox machinery out of the box:
//   - the generated {{.GoPkg}}.NewEntTxRunner makes a root+members Save one transaction;
//   - a persistence.AggregateRepository loads/saves the whole {{.Resource}} cluster
//     atomically over the generated Load{{.Resource}}Aggregate graph-load primitive;
//   - an events.Publisher + events.Dispatcher form a transactional outbox so a
//     change to {{.Resource}} can react onto another aggregate by eventual consistency.
//
// The outbox here uses the SDK's engine-free dev stores (persistence.MemoryOutboxStore
// + an in-memory idempotency store) so the scaffold compiles and runs out of the
// box. For a durable, SQL-backed ent outbox, add an Outbox + IdemMarker ent schema
// and an ent OutboxStore that appends through the ctx *ent.Tx — see the worked
// example in the SDK's testdata/iam (outbox_store.go + idempotency_store.go).
{{- end}}
package main

import (
	"context"
	"database/sql"
	"database/sql/driver"
	"flag"
	"log"
	"log/slog"
	"os"
	"os/signal"
	"syscall"
	"time"

	_ "modernc.org/sqlite" // registers the pure-Go "sqlite" driver

	"github.com/infobloxopen/devedge-sdk/authz"
	"github.com/infobloxopen/devedge-sdk/authz/grpcauthz"
	"github.com/infobloxopen/devedge-sdk/config"
{{- if .Aggregate}}
	"github.com/infobloxopen/devedge-sdk/events"
{{- end}}
	sdkhealth "github.com/infobloxopen/devedge-sdk/health"
	"github.com/infobloxopen/devedge-sdk/observability/otel"
	"github.com/infobloxopen/devedge-sdk/persistence"
	"github.com/infobloxopen/devedge-sdk/server"

	entclient "{{.Module}}/gen/ent"
	_ "{{.Module}}/gen/ent/runtime" // required by ent schema hooks (mixins)
	{{.GoPkg}} "{{.GoImportPath}}"
)

// version is the service version stamped onto every span/metric (OTel resource
// service.version). Override at build time with -ldflags "-X main.version=...".
var version = "0.0.0-dev"

// registerSQLite3 aliases the pure-Go "sqlite" driver (modernc.org/sqlite) under
// the name "sqlite3" that ent's dialect.SQLite expects. SQLite (no CGo) keeps the
// scaffold runnable out of the box; point ent.Open at postgres/mysql in production.
func registerSQLite3() error {
	for _, name := range sql.Drivers() {
		if name == "sqlite3" {
			return nil // already registered (e.g. mattn/go-sqlite3)
		}
	}
	db, err := sql.Open("sqlite", ":memory:")
	if err != nil {
		return err
	}
	drv := db.Driver()
	_ = db.Close()
	sql.Register("sqlite3", drv.(driver.Driver))
	return nil
}

{{- if .Aggregate}}

// newClient opens the ent client and runs the schema migration. SQLite (no CGo)
// keeps the scaffold runnable out of the box; point ent.Open at postgres/mysql in
// production.
func newClient() (*entclient.Client, error) {
	if err := registerSQLite3(); err != nil {
		return nil, err
	}
	client, err := entclient.Open("sqlite3", "file::memory:?cache=shared&_pragma=foreign_keys(1)")
	if err != nil {
		return nil, err
	}
	if err := client.Schema.Create(context.Background()); err != nil {
		return nil, err
	}
	return client, nil
}

// newAggregate wires the SDK's backend-neutral persistence.AggregateRepository
// over the generated ent repositories: Load uses the generated graph-load
// primitive Load{{.Resource}}Aggregate, and Save tracks {{.Member}} (member)
// mutations against the stored cluster — adds/updates/removes through the generated
// {{.Member}}EntRepository — all inside ONE NewEntTxRunner transaction, bumping the
// {{.Resource}} (root) etag on any member change.
//
// The service's standard CRUD still runs over the flat {{.Resource}} repository;
// this aggregate repository is the seam for a custom handler that mutates the whole
// {{.Resource}} cluster atomically (embed the generated CRUDHandler and override the
// methods that need it).
func newAggregate(client *entclient.Client) *persistence.GenericAggregateRepository[*{{.GoPkg}}.{{.Resource}}, string] {
	roots := {{.GoPkg}}.New{{.Resource}}EntRepository(client)
	members := {{.GoPkg}}.New{{.Member}}EntRepository(client)
	return persistence.NewGenericAggregateRepository(persistence.AggregateSpec[*{{.GoPkg}}.{{.Resource}}, string]{
		Tx:       {{.GoPkg}}.NewEntTxRunner(client),
		RootRepo: roots,
		KeyOf:    func(r *{{.GoPkg}}.{{.Resource}}) string { return r.GetId() },
		EtagOf:   func(r *{{.GoPkg}}.{{.Resource}}) string { return r.GetEtag() },
		LoadMembers: func(ctx context.Context, root *{{.GoPkg}}.{{.Resource}}) (*{{.GoPkg}}.{{.Resource}}, error) {
			return {{.GoPkg}}.Load{{.Resource}}Aggregate(ctx, client, root.GetId())
		},
		SaveMembers: func(ctx context.Context, root *{{.GoPkg}}.{{.Resource}}) (bool, error) {
			// Member-mutation tracking: diff the incoming members against what is
			// stored (loaded fresh inside the tx) and apply adds/updates/removes.
			stored, err := {{.GoPkg}}.Load{{.Resource}}Aggregate(ctx, client, root.GetId())
			if err != nil {
				return false, err
			}
			storedByID := map[string]*{{.GoPkg}}.{{.Member}}{}
			for _, mbr := range stored.Get{{.MemberField}}() {
				storedByID[mbr.GetId()] = mbr
			}
			changed := false
			wantIDs := map[string]struct{}{}
			for _, mbr := range root.Get{{.MemberField}}() {
				wantIDs[mbr.GetId()] = struct{}{}
				mbr.{{.MemberFKGoField}} = root.GetId()
				if mbr.AccountId == "" {
					mbr.AccountId = root.GetAccountId()
				}
				if _, ok := storedByID[mbr.GetId()]; !ok {
					if _, cerr := members.Create(ctx, mbr); cerr != nil {
						return false, cerr
					}
					changed = true
				} else {
					if _, uerr := members.Update(ctx, mbr.GetId(), mbr); uerr != nil {
						return false, uerr
					}
					changed = true
				}
			}
			for id := range storedByID {
				if _, keep := wantIDs[id]; !keep {
					if derr := members.Delete(ctx, id); derr != nil {
						return false, derr
					}
					changed = true
				}
			}
			return changed, nil
		},
	})
}

// newOutbox wires the F032/F033 transactional-outbox seam. A Publisher records a
// domain event in the SAME transaction as the aggregate change that emitted it (call
// pub.Publish inside the runner's Atomically). The outbox is WRITE-ONLY (the only
// writes are the producer's INSERT and retention's partition drop). The Dispatcher
// consumes it as a FORWARD CURSOR for same-DB cross-aggregate reactions: it reads
// events in order, runs the handlers you Subscribe — each in its OWN transaction
// (eventual consistency across aggregates) — and advances its position in a SIDECAR
// cursor store, never touching the outbox rows. Run ONE dispatcher instance per
// service; wire reactions with d.Subscribe(...) and run d.Poll(ctx, ...) from a
// background goroutine. (Cross-server delivery to queues is out of scope — an external
// project tails the outbox via persistence.OutboxCDCConsumer.)
//
// This uses the SDK's engine-free DEV stores so the scaffold runs out of the box: an
// in-memory write-only outbox, an in-memory cursor sidecar, an in-memory TxRunner for
// the dispatch side, and the auto-enrolled in-memory idempotency store. For
// durability, replace store + cursors + tx with the SQL-backed ent OutboxStore
// (appending through the ctx *ent.Tx), the EntOutboxCursorStore, and the generated
// NewEntTxRunner — see testdata/iam in the SDK for the worked example.
func newOutbox() (events.Publisher, *events.Dispatcher) {
	store := persistence.NewMemoryOutboxStore()
	cursors := persistence.NewMemoryOutboxCursorStore()
	tx := persistence.NewMemoryTxRunner()
	pub := events.NewOutboxPublisher(store)
	d := events.NewDispatcher(store, cursors, tx, nil) // nil => auto in-memory idempotency
	// Example: react to your aggregate's events here.
	//   d.Subscribe("{{.ResourceSnake}}.changed", "my-reaction", func(ctx context.Context, evt events.Event) error { ... })
	return pub, d
}
{{- else}}

// newRepository opens the ent client, runs the schema migration, and returns
// both the GENERATED ent repository adapter and the underlying *sql.DB (used
// to register a DB-ping readiness check — no ORM enters core). dsn is the
// connection string; when empty it defaults to an in-memory SQLite database.
// SQLite (no CGo) keeps the scaffold runnable out of the box; point ent.Open
// at postgres/mysql in production.
func newRepository(dsn string) (persistence.Repository[*{{.GoPkg}}.{{.Resource}}, string], *sql.DB, error) {
	if dsn == "" {
		dsn = "file::memory:?cache=shared&_pragma=foreign_keys(1)"
	}
	if err := registerSQLite3(); err != nil {
		return nil, nil, err
	}
	client, err := entclient.Open("sqlite3", dsn)
	if err != nil {
		return nil, nil, err
	}
	if err := client.Schema.Create(context.Background()); err != nil {
		return nil, nil, err
	}
	// Open a stdlib *sql.DB on the same DSN for the health check. This avoids
	// pulling ORM types into server.Config (AC-5) and matches the production
	// pattern: supply the same DSN (or a dedicated health connection).
	sqlDB, err := sql.Open("sqlite3", dsn)
	if err != nil {
		return nil, nil, err
	}
	return {{.GoPkg}}.New{{.Resource}}EntRepository(client), sqlDB, nil
}
{{- end}}

// newServer builds a fully wired server with the given authorizer, listen
// addresses, and database DSN. Returns an error (rather than panicking) so tests
// can assert the fail-closed authz gate. The smoke test passes ":0" for
// kernel-assigned ports and "" for the DSN (in-memory sqlite).
func newServer(authorizer authz.Authorizer, grpcAddr, httpAddr, dsn string) (*server.Server, error) {
{{- if .Aggregate}}
	client, err := newClient()
	if err != nil {
		return nil, err
	}
	// Aggregate + outbox machinery wired out of the box. The flat CRUD handler is
	// registered below; agg/pub/d are ready for a custom handler that mutates the
	// {{.Resource}} cluster atomically and reacts across aggregates via the outbox.
	// They are assigned to _ here so the scaffold compiles and runs before you add
	// your own handler + dispatch loop.
	agg := newAggregate(client)
	pub, d := newOutbox()
	_, _, _ = agg, pub, d
	repo := {{.GoPkg}}.New{{.Resource}}EntRepository(client)
	// For the DB-ping readiness check, open a stdlib *sql.DB on the same DSN.
	// This keeps ORM types out of server.Config (AC-5).
	entDSN := dsn
	if entDSN == "" {
		entDSN = "file::memory:?cache=shared&_pragma=foreign_keys(1)"
	}
	sqlDB, err := sql.Open("sqlite3", entDSN)
	if err != nil {
		return nil, err
	}
{{- else}}
	repo, sqlDB, err := newRepository(dsn)
	if err != nil {
		return nil, err
	}
{{- end}}
	s, err := server.New(server.Config{
		GRPCAddr:   grpcAddr,
		HTTPAddr:   httpAddr,
		Authorizer: authorizer,
		// Derive the caller's authz.Principal from request metadata (account-id ->
		// tenant, groups -> group:<name>). Without it the principal is empty and
		// every call is denied. Swap for a verified-token PrincipalFunc in prod.
		PrincipalFunc: grpcauthz.DevPrincipalFunc(),
		// Structured request logging is on by default (one trace-correlated slog
		// record per RPC; secret-annotated payload fields redacted at Debug).
		Logger: slog.Default(),
		// DB-ping readiness check: the server's /readyz and gRPC health status
		// flip to unready when the database is unreachable. The check uses the
		// stdlib PingContext interface — no ORM import enters core.
		ReadinessChecks: []sdkhealth.Check{sdkhealth.NewDBCheck("db", sqlDB)},
	})
	if err != nil {
		return nil, err
	}
	// One call: construct the generated default CRUD handler over repo, register it
	// (gRPC + REST gateway), and contribute the service's authz rules.
	if err := {{.GoPkg}}.Register{{.ServiceType}}WithRepository(s, repo); err != nil {
		return nil, err
	}
	return s, nil
}

func main() {
	// Graceful shutdown: cancel ctx on SIGTERM (k8s pod termination) or Ctrl-C so
	// server.Serve returns and runs its graceful gRPC/HTTP drain, the readiness
	// loop stops, and the deferred OTel flush below runs before exit. The
	// chart's terminationGracePeriodSeconds / compose's stop_grace_period give
	// this drain its time budget.
	ctx, stop := signal.NotifyContext(context.Background(), syscall.SIGTERM, os.Interrupt)
	defer stop()

	// Configuration — load server options from flags, environment, and .env file.
	// Precedence (highest → lowest): flags > env ({{.ServiceUpper}}_*) > .env file > defaults.
	//
	// Key env vars:
	//   {{.ServiceUpper}}_GRPC_ADDR    — gRPC listen address  (default :{{.GRPCPort}})
	//   {{.ServiceUpper}}_HTTP_ADDR    — HTTP gateway address  (default :{{.HTTPPort}})
	//   {{.ServiceUpper}}_LOG_LEVEL    — log level             (default info)
	//   {{.ServiceUpper}}_OTLP_ENDPOINT — OTel collector      (default: $OTEL_EXPORTER_OTLP_ENDPOINT)
	//   {{.ServiceUpper}}_DSN           — database DSN          (default: in-memory sqlite)
	fs := flag.NewFlagSet("{{.BinName}}", flag.ExitOnError)
	// Register the override flags so config.Flags(fs) can see them. The flag
	// names match the config keys; config.Flags reads only flags explicitly set
	// on the command line (it ignores these zero-value defaults), so the
	// documented precedence (flag > env > .env > struct default) holds. Parse
	// BEFORE config.Load — config.Flags inspects which flags were set, so the
	// parse must happen first.
	fs.String("GRPC_ADDR", "", "gRPC listen address (overrides {{.ServiceUpper}}_GRPC_ADDR)")
	fs.String("HTTP_ADDR", "", "HTTP gateway address (overrides {{.ServiceUpper}}_HTTP_ADDR)")
	fs.String("LOG_LEVEL", "", "log level: debug/info/warn/error")
	fs.String("OTLP_ENDPOINT", "", "OpenTelemetry collector endpoint")
	fs.String("DSN", "", "database connection string")
	if err := fs.Parse(os.Args[1:]); err != nil {
		log.Fatalf("{{.BinName}}: flags: %v", err)
	}
	var opts config.ServerOptions
	if err := config.Load(&opts,
		config.Flags(fs),
		config.Env("{{.ServiceUpper}}_"),
		config.DotEnv(".env"),
	); err != nil {
		log.Fatalf("{{.BinName}}: config: %v", err)
	}

	// Observability is wired behind the SDK's OTel seam. otel.Setup installs the
	// global tracer/meter providers + a W3C propagator; the server's built-in
	// otelgrpc/otelhttp instrumentation then emits per-RPC spans + RED metrics and
	// one end-to-end trace across the REST gateway hop, with no per-handler code.
	// OTLPEndpoint comes from config ({{.ServiceUpper}}_OTLP_ENDPOINT); when empty it
	// honours $OTEL_EXPORTER_OTLP_ENDPOINT, no-opping cleanly if that is also unset.
	shutdown, err := otel.Setup(ctx, otel.Config{
		ServiceName:    "{{.BinName}}",
		ServiceVersion: version,
		OTLPEndpoint:   opts.OTLPEndpoint,
	})
	if err != nil {
		log.Fatalf("{{.BinName}}: observability: %v", err)
	}
	defer func() {
		sctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
		defer cancel()
		_ = shutdown(sctx)
	}()

	// Dev authorizer: grants the "admin" group every verb on every resource in any
	// tenant. Paired with grpcauthz.DevPrincipalFunc (wired in newServer), a caller
	// is authorized when it sends `account-id: <tenant>` and `groups: admin`; anyone
	// else fails closed (PermissionDenied). Replace BOTH the grant and the
	// PrincipalFunc with a real policy + verified-token func in production.
	authorizer := authz.NewDevAuthorizer(authz.Grant{
		Tenant:   "*",
		Subjects: []string{"group:admin"},
		Verbs:    []authz.Verb{"*"},
		Resource: "*",
	})
	s, err := newServer(authorizer, opts.GRPCAddr, opts.HTTPAddr, opts.DSN)
	if err != nil {
		log.Fatalf("{{.BinName}}: init: %v", err)
	}
	log.Printf("{{.BinName}}: serving gRPC on %s, HTTP on %s", opts.GRPCAddr, opts.HTTPAddr)
	if err := s.Serve(ctx); err != nil {
		log.Fatalf("{{.BinName}}: serve: %v", err)
	}
}
