module {{.Module}}

go 1.25

// ent backend: the persistence layer is the generated ent schema/client + the
// generated New{{.Resource}}EntRepository adapter (F027). There is NO gorm
// dependency here — the engine deps that appear are ent + a pure-Go SQLite
// driver, kept in THIS module's go.mod only (never the SDK's, never the proto).
require (
	entgo.io/ent {{.EntVersion}}
	github.com/grpc-ecosystem/grpc-gateway/v2 {{.GRPCGatewayVersion}}
	github.com/infobloxopen/apis/proto/infoblox/authz {{.AuthzBindingVersion}}
	github.com/infobloxopen/apis/proto/infoblox/field {{.FieldBindingVersion}}
	github.com/infobloxopen/devedge-sdk {{.SDKVersion}}
	google.golang.org/genproto/googleapis/api {{.GenprotoAPIVersion}}
	google.golang.org/grpc {{.GRPCVersion}}
	google.golang.org/protobuf {{.ProtobufVersion}}
	modernc.org/sqlite {{.ModerncSQLiteVersion}}
)

// Observability (F034): the OTel SDK + exporters are pulled in only through the
// SDK's observability/otel adapter that the generated main wires; `go mod tidy`
// records them as indirect requires here. Pinning the OTel API keeps that
// reconciliation deterministic; configure the exporter at runtime via the
// standard OTEL_* env (see README).
require go.opentelemetry.io/otel {{.OTelAPIVersion}} // indirect
