name: image

# Build and publish the [[ .Service ]] container image to GitHub Container Registry
# on merge to main (and on v* tags). The image is built with ko (via `de image`),
# so there is NO Dockerfile: ko compiles the Go binary CGO-free and lays it on a
# distroless STATIC base, multi-arch. The image is repo-namespaced and NON-NESTED:
# ghcr.io/<owner>/<repo>.
#
# gen/ is git-ignored, so — exactly like ci.yml — the consumer-local code is
# generated BEFORE the build. `de` is the hermetic build authority: `de generate`
# installs the pinned buf + codegen plugins and regenerates; `de image` runs the
# pinned ko. Both come from a single PINNED `de` — no unpinned tool installs.
#
# This template is rendered with square-bracket delimiters so GitHub Actions'
# ${{ ... }} passes through verbatim.

on:
  push:
    branches: ["main"]
    tags: ["v*"]

permissions:
  contents: read
  packages: write

jobs:
  image:
    runs-on: ubuntu-latest
    strategy:
      matrix:
        # One image per binary. A single-binary service publishes NON-NESTED at
        # ghcr.io/<owner>/<repo> (empty suffix). For an additional binary, add a row
        # with a "-<name>" suffix — still non-nested, e.g.
        # `{ binary: worker, suffix: "-worker" }` -> ghcr.io/<owner>/<repo>-worker.
        # ko --bare publishes EXACTLY KO_DOCKER_REPO, and builds ./cmd/<binary>.
        include:
          - binary: "[[ .BinName ]]"
            suffix: ""
    env:
      # Repo-namespaced, non-nested target. `ko build --bare` publishes EXACTLY this.
      KO_DOCKER_REPO: ghcr.io/${{ github.repository }}${{ matrix.suffix }}
    steps:
      - uses: actions/checkout@v4

      - name: Set up Go
        uses: actions/setup-go@v5
        with:
          go-version-file: go.mod
          cache: true

      - name: Install de (the devedge build authority)
        run: go install github.com/infobloxopen/devedge/cmd/de@[[ .DeVersion ]]

      # gen/ is git-ignored: regenerate the consumer-local code ko compiles.
      - name: Generate consumer-local code
        run: de generate

      - name: Log in to GHCR
        uses: docker/login-action@v3
        with:
          registry: ghcr.io
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}

      - name: Compute tags
        id: tags
        run: |
          short=$(git rev-parse --short HEAD)
          case "$GITHUB_REF" in
            refs/tags/v*) echo "tags=${GITHUB_REF_NAME#v},sha-$short" >> "$GITHUB_OUTPUT" ;;
            *)            echo "tags=latest,sha-$short" >> "$GITHUB_OUTPUT" ;;
          esac

      # `de image` runs the PINNED ko: distroless STATIC base, reproducible
      # (-trimpath) multi-arch build. Tokens after `--` pass through to ko verbatim,
      # so `--bare` keeps the image non-nested and `--tags` sets the published tags.
      - name: Build and push (de image -> pinned ko, distroless static, multi-arch)
        run: |
          de image --push --repo "$KO_DOCKER_REPO" \
            --base gcr.io/distroless/static-debian12:nonroot \
            -- --bare \
            --tags "${{ steps.tags.outputs.tags }}" \
            ./cmd/[[ .BinName ]]
