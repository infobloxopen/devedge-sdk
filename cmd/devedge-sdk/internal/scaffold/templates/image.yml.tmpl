name: image

# Build and publish the [[ .Service ]] container image to GitHub Container Registry
# on merge to main (and on v* tags). The image is repo-namespaced and NON-NESTED:
# ghcr.io/<owner>/<repo>.
#
# gen/ is git-ignored, so — exactly like ci.yml — the consumer-local code is
# generated BEFORE the Docker build (`make bootstrap` = tools + generate). The
# Dockerfile then compiles the generated tree into a distroless, static image.
#
# This template is rendered with square-bracket delimiters so GitHub Actions'
# ${{ ... }} and docker/metadata-action's {{ ... }} pass through verbatim.

on:
  push:
    branches: ["main"]
    tags: ["v*"]

permissions:
  contents: read
  packages: write

jobs:
  image:
    runs-on: ubuntu-latest
    strategy:
      matrix:
        # One image per binary. A single-binary service publishes NON-NESTED at
        # ghcr.io/<owner>/<repo> (empty suffix). When this repo grows additional
        # binaries, add one row per binary with a "-<name>" suffix — still
        # non-nested, e.g. `{ binary: worker, suffix: "-worker" }` publishes
        # ghcr.io/<owner>/<repo>-worker. The Dockerfile builds ./cmd/<binary>.
        include:
          - binary: "[[ .BinName ]]"
            suffix: ""
    steps:
      - uses: actions/checkout@v4

      - name: Set up Go
        uses: actions/setup-go@v5
        with:
          go-version-file: go.mod
          cache: true

      - name: Install buf
        uses: bufbuild/buf-setup-action@v1

      - name: Install apx
        uses: infobloxopen/apx@main

      # gen/ is git-ignored: install the codegen plugins (pinned to the SDK in
      # go.mod) and generate the consumer-local code the Docker build compiles.
      - name: Generate consumer-local code
        run: make bootstrap

      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v3

      - name: Log in to GHCR
        uses: docker/login-action@v3
        with:
          registry: ghcr.io
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}

      - name: Image metadata
        id: meta
        uses: docker/metadata-action@v5
        with:
          # Repo-namespaced, non-nested: ghcr.io/<owner>/<repo>[<suffix>].
          images: ghcr.io/${{ github.repository }}${{ matrix.suffix }}
          tags: |
            type=ref,event=branch
            type=sha,format=short
            type=semver,pattern={{version}}
            type=raw,value=latest,enable={{is_default_branch}}

      - name: Build and push
        uses: docker/build-push-action@v6
        with:
          context: .
          platforms: linux/amd64,linux/arm64
          push: true
          provenance: false
          tags: ${{ steps.meta.outputs.tags }}
          labels: ${{ steps.meta.outputs.labels }}
          build-args: |
            BINARY=${{ matrix.binary }}
            VERSION=${{ steps.meta.outputs.version }}
