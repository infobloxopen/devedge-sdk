version: v2
# ent backend (F028 Phase 4, consumes F027's generated repository adapter).
#
# Six SDK/public `local:` plugins. Output lands under gen/ (git-ignored,
# consumer-local). Differences from the gorm template:
#   - protoc-gen-ent REPLACES protoc-gen-storage: the persistence layer is the
#     ent schema + the generated New{{.Resource}}EntRepository adapter, not the
#     GORM model + repository. (No gorm in an ent service.)
#   - protoc-gen-ent takes NO `module=` opt (the others do): it derives its
#     output dir from the proto's Go package, emitting ent/ as a sibling of the
#     proto package dir (gen/ent, next to gen/{{.GoPkg}}). This is why the proto
#     go_package is a single segment ("gen/{{.GoPkg}}"): so the generated ent/
#     package compiles as a sibling. (Aligning it to <module>/proto/<svc>/v1 — what
#     apx expects — breaks the ent build; the resulting go_package mismatch warning
#     from `apx release prepare` is therefore expected and harmless — see README.)
#   - protoc-gen-ent emits ent SCHEMAS + the repo adapter only; the ent CLIENT
#     is generated in a SECOND step by entc (`go generate ./gen/ent`), which
#     `make generate` and the scaffold's first generate run for you.
#
# The SDK plugins (protoc-gen-{devedge-authz,svc,ent}) must be on PATH for buf;
# `make generate` installs them pinned to the SDK version. The public plugins
# (protoc-gen-{go,go-grpc,grpc-gateway}) come from your toolchain.
inputs:
  - directory: proto
    paths:
      - proto/{{.ProtoPathSuffix}}/{{.ProtoFile}}
plugins:
  - local: protoc-gen-go
    out: gen
    opt: module={{.Module}}/gen
  - local: protoc-gen-go-grpc
    out: gen
    opt: module={{.Module}}/gen
  - local: protoc-gen-devedge-authz
    out: gen
    opt: module={{.Module}}/gen
  - local: protoc-gen-svc
    out: gen
    opt: module={{.Module}}/gen
  - local: protoc-gen-grpc-gateway
    out: gen
    opt: module={{.Module}}/gen
  # protoc-gen-ent: NO module= opt. Emits gen/ent/schema/* (ent schemas),
  # gen/ent/generate.go (the entc //go:generate directive), and the
  # gen/{{.GoPkg}}/*.ent.go repository adapter (F027). The ent client itself is
  # generated by `go generate ./gen/ent` afterward.
  - local: protoc-gen-ent
    out: gen
    opt: dialect=sqlite
